<!-- TEMPLATE: analisis-arquitectura | Version: dinamica desde ESTADO_PROYECTO.json -->
<!-- Uso: Claude rellena los placeholders {{...}} con contenido HTML del analisis. -->
<!-- El comando /analisis-arquitectura genera este archivo automaticamente. -->
<!DOCTYPE html>
<html lang="es" data-theme="light">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Analisis Arquitectonico — {{NOMBRE_PROYECTO}}</title>
    <script src="https://cdn.jsdelivr.net/npm/mermaid/dist/mermaid.min.js"></script>
    <style>
        /* ===== CSS Variables ===== */
        :root {
            --primary: #33475B;
            --primary-light: #0066CC;
            --primary-hover: #24333F;
            --accent: #E8F4FD;
            --bg: #f5f7fa;
            --bg-card: #ffffff;
            --text: #1a1a2e;
            --text-muted: #6c757d;
            --border: #dee2e6;
            --sidebar-bg: #33475B;
            --sidebar-text: #ffffff;
            --badge-critical: #DC3545;
            --badge-high: #FD7E14;
            --badge-medium: #FFC107;
            --badge-ok: #28a745;
            --badge-warn: #FD7E14;
            --font: 'Segoe UI', system-ui, -apple-system, sans-serif;
        }

        [data-theme="dark"] {
            --primary: #4da6ff;
            --primary-light: #66b3ff;
            --accent: #1a2a3a;
            --bg: #121212;
            --bg-card: #1e1e1e;
            --text: #e0e0e0;
            --text-muted: #adb5bd;
            --border: #333;
            --sidebar-bg: #0d1b2a;
            --sidebar-text: #e0e0e0;
        }

        /* ===== Reset & Base ===== */
        *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

        body {
            font-family: var(--font);
            background: var(--bg);
            color: var(--text);
            line-height: 1.6;
            font-size: 15px;
        }

        /* ===== Sidebar ===== */
        .sidebar {
            position: fixed;
            top: 0; left: 0;
            width: 260px;
            height: 100vh;
            background: var(--sidebar-bg);
            color: var(--sidebar-text);
            overflow-y: auto;
            z-index: 100;
            padding: 1.5rem 0;
            transition: transform 0.3s ease;
        }

        .sidebar-header {
            padding: 0 1.2rem 1rem;
            border-bottom: 1px solid rgba(255,255,255,0.15);
            margin-bottom: 1rem;
        }

        .sidebar-header h2 {
            font-size: 1rem;
            font-weight: 600;
            color: #ffffff;
            margin-bottom: 0.3rem;
        }

        .sidebar-header .subtitle {
            font-size: 0.75rem;
            color: rgba(255,255,255,0.6);
        }

        .sidebar nav a {
            display: block;
            padding: 0.5rem 1.2rem;
            color: rgba(255,255,255,0.8);
            text-decoration: none;
            font-size: 0.85rem;
            border-left: 3px solid transparent;
            transition: all 0.2s;
        }

        .sidebar nav a:hover,
        .sidebar nav a.active {
            background: rgba(255,255,255,0.1);
            color: #ffffff;
            border-left-color: var(--primary-light);
        }

        .sidebar nav a .num {
            display: inline-block;
            width: 1.5em;
            color: rgba(255,255,255,0.5);
            font-size: 0.8rem;
        }

        /* ===== Main Content ===== */
        .main {
            margin-left: 260px;
            padding: 2rem 3rem;
            max-width: 1200px;
        }

        /* ===== Topbar ===== */
        .topbar {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 2rem;
            padding-bottom: 1rem;
            border-bottom: 2px solid var(--primary);
        }

        .topbar h1 {
            font-size: 1.6rem;
            color: var(--primary);
            font-weight: 700;
        }

        .topbar-meta {
            display: flex;
            gap: 1rem;
            align-items: center;
        }

        .topbar-meta .badge {
            padding: 0.3rem 0.8rem;
            border-radius: 20px;
            font-size: 0.75rem;
            font-weight: 600;
        }

        .badge-type {
            background: var(--accent);
            color: var(--primary);
            border: 1px solid var(--primary-light);
        }

        .badge-version {
            background: var(--primary);
            color: #fff;
        }

        /* ===== Theme Toggle ===== */
        .theme-toggle {
            position: fixed;
            top: 1rem; right: 1rem;
            z-index: 200;
            background: var(--bg-card);
            border: 1px solid var(--border);
            border-radius: 50%;
            width: 40px; height: 40px;
            cursor: pointer;
            font-size: 1.2rem;
            display: flex;
            align-items: center;
            justify-content: center;
            box-shadow: 0 2px 8px rgba(0,0,0,0.15);
        }

        /* ===== Hamburger Mobile ===== */
        .hamburger {
            display: none;
            position: fixed;
            top: 1rem; left: 1rem;
            z-index: 200;
            background: var(--primary);
            color: #fff;
            border: none;
            border-radius: 6px;
            width: 40px; height: 40px;
            cursor: pointer;
            font-size: 1.5rem;
        }

        /* ===== Section ===== */
        .section {
            background: var(--bg-card);
            border-radius: 8px;
            padding: 2rem;
            margin-bottom: 2rem;
            box-shadow: 0 1px 4px rgba(0,0,0,0.06);
            border: 1px solid var(--border);
            scroll-margin-top: 1rem;
        }

        .section h2 {
            color: var(--primary);
            font-size: 1.3rem;
            margin-bottom: 1rem;
            padding-bottom: 0.5rem;
            border-bottom: 2px solid var(--accent);
        }

        .section h3 {
            color: var(--primary);
            font-size: 1.05rem;
            margin: 1.2rem 0 0.6rem;
        }

        /* ===== Metric Cards ===== */
        .metrics-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
            gap: 1rem;
            margin: 1rem 0;
        }

        .metric-card {
            background: var(--bg);
            border-radius: 8px;
            padding: 1.2rem;
            text-align: center;
            border-top: 4px solid var(--primary);
        }

        .metric-card .val {
            font-size: 2rem;
            font-weight: 700;
            color: var(--primary);
        }

        .metric-card .label {
            font-size: 0.8rem;
            color: var(--text-muted);
            margin-top: 0.3rem;
        }

        /* ===== Tables ===== */
        table {
            width: 100%;
            border-collapse: collapse;
            margin: 1rem 0;
            font-size: 0.9rem;
        }

        th {
            background: var(--primary);
            color: #fff;
            padding: 0.7rem 0.8rem;
            text-align: left;
            font-weight: 600;
            font-size: 0.85rem;
        }

        td {
            padding: 0.6rem 0.8rem;
            border-bottom: 1px solid var(--border);
        }

        tr:hover td { background: var(--accent); }

        /* ===== Severity Badges ===== */
        .severity { display: inline-flex; align-items: center; gap: 0.3rem; padding: 0.2rem 0.6rem; border-radius: 12px; font-size: 0.8rem; font-weight: 600; }
        .severity-critical { background: #fce4e4; color: var(--badge-critical); }
        .severity-high { background: #fff3e0; color: #e65100; }
        .severity-medium { background: #fff8e1; color: #f57f17; }

        /* ===== Audit Checklist ===== */
        .audit-pass { background: #e8f5e9 !important; }
        .audit-warn { background: #fff8e1 !important; }
        .audit-fail { background: #fce4e4 !important; }

        /* ===== Score Bar ===== */
        .score-container {
            margin: 2rem 0;
            text-align: center;
        }

        .score-bar-wrapper {
            background: #e9ecef;
            border-radius: 12px;
            height: 28px;
            overflow: hidden;
            margin: 0.5rem 0;
        }

        .score-bar {
            height: 100%;
            border-radius: 12px;
            transition: width 0.8s ease;
            display: flex;
            align-items: center;
            justify-content: flex-end;
            padding-right: 0.8rem;
            color: #fff;
            font-weight: 700;
            font-size: 0.85rem;
        }

        .score-label {
            font-size: 2.5rem;
            font-weight: 800;
            color: var(--primary);
        }

        /* ===== Viability Gauge ===== */
        .gauge-container {
            display: flex;
            align-items: center;
            gap: 2rem;
            margin: 1.5rem 0;
            padding: 1.5rem;
            background: var(--bg);
            border-radius: 12px;
        }

        .gauge {
            position: relative;
            width: 120px; height: 120px;
        }

        .gauge svg { transform: rotate(-90deg); }

        .gauge-circle-bg {
            fill: none;
            stroke: #e9ecef;
            stroke-width: 10;
        }

        .gauge-circle {
            fill: none;
            stroke-width: 10;
            stroke-linecap: round;
            transition: stroke-dashoffset 0.8s ease;
        }

        .gauge-text {
            position: absolute;
            top: 50%; left: 50%;
            transform: translate(-50%, -50%);
            font-size: 1.5rem;
            font-weight: 800;
            color: var(--primary);
        }

        .gauge-info h3 { margin-bottom: 0.5rem; }
        .gauge-info p { color: var(--text-muted); font-size: 0.9rem; }

        /* ===== Migration Timeline ===== */
        .timeline {
            position: relative;
            margin: 2rem 0;
            padding-left: 2rem;
        }

        .timeline::before {
            content: '';
            position: absolute;
            left: 0.8rem;
            top: 0; bottom: 0;
            width: 3px;
            background: var(--primary-light);
        }

        .timeline-item {
            position: relative;
            margin-bottom: 1.5rem;
            padding: 1rem 1.2rem;
            background: var(--bg);
            border-radius: 8px;
            border-left: 4px solid var(--primary);
        }

        .timeline-item::before {
            content: '';
            position: absolute;
            left: -2.15rem;
            top: 1.2rem;
            width: 14px; height: 14px;
            background: var(--primary);
            border-radius: 50%;
            border: 3px solid var(--bg-card);
        }

        .timeline-item .phase {
            font-weight: 700;
            color: var(--primary);
            font-size: 0.9rem;
        }

        .timeline-item .sprints {
            font-size: 0.8rem;
            color: var(--text-muted);
        }

        /* ===== Collapsible Details ===== */
        details {
            margin: 0.5rem 0;
            border: 1px solid var(--border);
            border-radius: 6px;
            overflow: hidden;
        }

        details summary {
            padding: 0.7rem 1rem;
            background: var(--bg);
            cursor: pointer;
            font-weight: 600;
            font-size: 0.9rem;
            list-style: none;
        }

        details summary::before {
            content: '▶ ';
            font-size: 0.7rem;
            transition: transform 0.2s;
            display: inline-block;
        }

        details[open] summary::before {
            transform: rotate(90deg);
        }

        details .detail-content {
            padding: 1rem;
        }

        /* ===== Migration Section Banner ===== */
        .migration-banner {
            background: linear-gradient(135deg, var(--primary) 0%, var(--primary-light) 100%);
            color: #fff;
            border-radius: 8px;
            padding: 1.5rem 2rem;
            margin-bottom: 1.5rem;
        }

        .migration-banner h2 {
            color: #fff;
            border-bottom-color: rgba(255,255,255,0.3);
        }

        /* ===== Before/After Diagram ===== */
        .before-after {
            display: grid;
            grid-template-columns: 1fr auto 1fr;
            gap: 1rem;
            align-items: center;
            margin: 1.5rem 0;
        }

        .before-after .arrow {
            font-size: 2rem;
            color: var(--primary);
            font-weight: 700;
        }

        .before-after .panel {
            background: var(--bg);
            border-radius: 8px;
            padding: 1.2rem;
        }

        .before-after .panel h4 {
            color: var(--primary);
            margin-bottom: 0.5rem;
            text-align: center;
        }

        /* ===== Code Blocks ===== */
        code {
            background: var(--bg);
            padding: 0.15rem 0.4rem;
            border-radius: 4px;
            font-size: 0.85rem;
            font-family: 'Cascadia Code', 'Consolas', monospace;
        }

        pre {
            background: #1e1e2e;
            color: #cdd6f4;
            padding: 1rem;
            border-radius: 6px;
            overflow-x: auto;
            font-size: 0.85rem;
        }

        /* ===== Footer ===== */
        .footer {
            text-align: center;
            padding: 2rem;
            color: var(--text-muted);
            font-size: 0.8rem;
            border-top: 1px solid var(--border);
            margin-top: 2rem;
        }

        /* ===== Mermaid ===== */
        .mermaid {
            text-align: center;
            margin: 1.5rem 0;
        }

        /* ===== Responsive ===== */
        @media (max-width: 900px) {
            .sidebar { transform: translateX(-100%); }
            .sidebar.open { transform: translateX(0); }
            .main { margin-left: 0; padding: 1rem; }
            .hamburger { display: flex; }
            .metrics-grid { grid-template-columns: repeat(2, 1fr); }
            .before-after { grid-template-columns: 1fr; }
            .before-after .arrow { text-align: center; transform: rotate(90deg); }
            .gauge-container { flex-direction: column; text-align: center; }
        }

        /* ===== Print ===== */
        @media print {
            .sidebar, .hamburger, .theme-toggle { display: none !important; }
            .main { margin-left: 0; padding: 0.5cm; max-width: 100%; }
            .section { break-inside: avoid; box-shadow: none; border: 1px solid #ccc; }
            body { font-size: 11pt; }
            .score-bar { print-color-adjust: exact; -webkit-print-color-adjust: exact; }
            th { print-color-adjust: exact; -webkit-print-color-adjust: exact; }
            .migration-banner { print-color-adjust: exact; -webkit-print-color-adjust: exact; }

            h2 { page-break-after: avoid; }
            .section { page-break-before: auto; }
            #seccion-metricas { page-break-before: always; }
            #seccion-problemas { page-break-before: always; }
            #seccion-migracion { page-break-before: always; }
            #seccion-puntuacion { page-break-before: always; }
        }
    </style>
</head>
<body>

<!-- Hamburger Mobile -->
<button class="hamburger" onclick="toggleSidebar()" aria-label="Abrir menu">&#9776;</button>

<!-- Theme Toggle -->
<button class="theme-toggle" onclick="toggleTheme()" aria-label="Cambiar tema">&#9790;</button>

<!-- Sidebar -->
<aside class="sidebar" id="sidebar">
    <div class="sidebar-header">
        <h2>&#128203; Analisis Arquitectonico</h2>
        <div class="subtitle">{{NOMBRE_PROYECTO}} &mdash; v{{VERSION_ANALISIS}}</div>
    </div>
    <nav>
        <a href="#seccion-resumen"><span class="num">1.</span> Resumen Ejecutivo</a>
        <a href="#seccion-inventario"><span class="num">2.</span> Inventario</a>
        <a href="#seccion-dependencias"><span class="num">3.</span> Dependencias</a>
        <a href="#seccion-auditoria"><span class="num">4.</span> {{TITULO_NAV_4}}</a>
        <a href="#seccion-metricas"><span class="num">5.</span> Metricas</a>
        <a href="#seccion-patrones"><span class="num">6.</span> Patrones</a>
        <a href="#seccion-nuget"><span class="num">7.</span> NuGet</a>
        <a href="#seccion-problemas"><span class="num">8.</span> Problemas Criticos</a>
        <a href="#seccion-recomendaciones"><span class="num">9.</span> Recomendaciones</a>
        {{NAV_MIGRACION}}
        <a href="#seccion-puntuacion"><span class="num">{{NUM_PUNTUACION}}.</span> Puntuacion</a>
        <a href="#seccion-spec"><span class="num">&bull;</span> Especificacion</a>
    </nav>
</aside>

<!-- Main Content -->
<div class="main">
    <!-- Topbar -->
    <div class="topbar">
        <h1>Analisis Arquitectonico</h1>
        <div class="topbar-meta">
            <span class="badge badge-type">{{TIPO_BADGE}}</span>
            <span class="badge badge-version">v{{VERSION_ANALISIS}}</span>
            <span style="color:var(--text-muted); font-size:0.85rem;">{{FECHA_ANALISIS}}</span>
        </div>
    </div>

    <!-- 1. Resumen Ejecutivo -->
    <div class="section" id="seccion-resumen">
        <h2>1. Resumen Ejecutivo</h2>
        {{HTML_RESUMEN_EJECUTIVO}}
    </div>

    <!-- 2. Inventario -->
    <div class="section" id="seccion-inventario">
        <h2>2. Inventario de la Solucion</h2>
        {{HTML_INVENTARIO}}
    </div>

    <!-- 3. Diagrama de Dependencias -->
    <div class="section" id="seccion-dependencias">
        <h2>3. Diagrama de Dependencias</h2>
        <div class="mermaid">
{{MERMAID_DEPENDENCIAS}}
        </div>
        {{HTML_NOTAS_DIAGRAMA}}
    </div>

    <!-- 4. Auditoria / Arquitectura Actual -->
    <div class="section" id="seccion-auditoria">
        <h2>4. {{TITULO_SECCION_4}}</h2>
        {{HTML_SECCION_4}}
    </div>

    <!-- 5. Metricas -->
    <div class="section" id="seccion-metricas">
        <h2>5. Metricas Cuantitativas</h2>
        <div class="metrics-grid">
            {{HTML_METRIC_CARDS}}
        </div>
        <details>
            <summary>Ver tabla completa de metricas</summary>
            <div class="detail-content">
                {{HTML_METRICAS_TABLA}}
            </div>
        </details>
    </div>

    <!-- 6. Patrones -->
    <div class="section" id="seccion-patrones">
        <h2>6. Patrones de Diseno Detectados</h2>
        {{HTML_PATRONES}}
    </div>

    <!-- 7. NuGet -->
    <div class="section" id="seccion-nuget">
        <h2>7. Analisis de Dependencias NuGet</h2>
        <details>
            <summary>Ver tabla completa de paquetes NuGet</summary>
            <div class="detail-content">
                {{HTML_NUGET}}
            </div>
        </details>
        {{HTML_NUGET_OBSERVACIONES}}
    </div>

    <!-- 8. Problemas Criticos -->
    <div class="section" id="seccion-problemas">
        <h2>8. Los 5 Problemas Arquitectonicos Mas Criticos</h2>
