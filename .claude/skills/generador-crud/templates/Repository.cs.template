    Task<PaginatedResult<{{Entity}}>> GetPaginatedAsync(int page, int size, CancellationToken ct = default);
    Task<IReadOnlyList<{{Entity}}>> GetAllAsync(CancellationToken ct = default);
    Task<{{Entity}}> AddAsync({{Entity}} entity, CancellationToken ct = default);
