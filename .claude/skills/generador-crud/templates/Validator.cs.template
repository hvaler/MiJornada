public class Create{{Entity}}CommandValidator : AbstractValidator<Create{{Entity}}Command>
{
    private readonly I{{Entity}}Repository _repository;

    public Create{{Entity}}CommandValidator(I{{Entity}}Repository repository)
    {
        _repository = repository;

        // ═══════════════════════════════════════════════════════════════════
        // REGLAS DE VALIDACIÓN
        // ═══════════════════════════════════════════════════════════════════

        {{ReglasValidacionCrear}}
    }

    // ═══════════════════════════════════════════════════════════════════════
    // VALIDACIONES ASÍNCRONAS
    // ═══════════════════════════════════════════════════════════════════════

    {{MetodosValidacionAsync}}
}

// ═══════════════════════════════════════════════════════════════════════════
// VALIDATOR PARA ACTUALIZAR
// ═══════════════════════════════════════════════════════════════════════════

public class Update{{Entity}}CommandValidator : AbstractValidator<Update{{Entity}}Command>
{
    private readonly I{{Entity}}Repository _repository;

    public Update{{Entity}}CommandValidator(I{{Entity}}Repository repository)
    {
        _repository = repository;

        RuleFor(x => x.Id)
            .NotEmpty().WithMessage("El ID es obligatorio")
            .MustAsync(ExistirEntidad).WithMessage("{{Entity}} no encontrado/a");

        {{ReglasValidacionActualizar}}
    }

    private async Task<bool> ExistirEntidad(int id, CancellationToken ct)
    {
        return await _repository.ExistsAsync(id, ct);
    }

    {{MetodosValidacionAsyncActualizar}}
}

