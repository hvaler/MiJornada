#region Create{{Entity}}Command

public record Create{{Entity}}Command : IRequest<{{Entity}}Dto>
{
    {{PropiedadesCommand}}
}

public class Create{{Entity}}CommandHandler
    : IRequestHandler<Create{{Entity}}Command, {{Entity}}Dto>
{
    private readonly I{{Entity}}Repository _repository;
    private readonly IUnitOfWork _unitOfWork;
    private readonly IMapper _mapper;
    private readonly ILogger<Create{{Entity}}CommandHandler> _logger;

    public Create{{Entity}}CommandHandler(
        I{{Entity}}Repository repository,
        IUnitOfWork unitOfWork,
        IMapper mapper,
        ILogger<Create{{Entity}}CommandHandler> logger)
    {
        _repository = repository;
        _unitOfWork = unitOfWork;
        _mapper = mapper;
        _logger = logger;
    }

    public async Task<{{Entity}}Dto> Handle(
        Create{{Entity}}Command request,
        CancellationToken cancellationToken)
    {
        // Crear entidad usando factory del dominio
        var entity = {{Entity}}.Create(
            {{ArgumentosCrear}}
        );

        // Persistir
        await _repository.AddAsync(entity, cancellationToken);
        await _unitOfWork.SaveChangesAsync(cancellationToken);

        _logger.LogInformation(
            "{{Entity}} {Id} creado/a",
            entity.Id);

        return _mapper.Map<{{Entity}}Dto>(entity);
    }
}

#endregion

#region Update{{Entity}}Command

public record Update{{Entity}}Command : IRequest
{
    public int Id { get; init; }
    {{PropiedadesCommand}}
}

public class Update{{Entity}}CommandHandler : IRequestHandler<Update{{Entity}}Command>
{
    private readonly I{{Entity}}Repository _repository;
    private readonly IUnitOfWork _unitOfWork;
    private readonly ILogger<Update{{Entity}}CommandHandler> _logger;

    public Update{{Entity}}CommandHandler(
        I{{Entity}}Repository repository,
        IUnitOfWork unitOfWork,
        ILogger<Update{{Entity}}CommandHandler> logger)
    {
        _repository = repository;
        _unitOfWork = unitOfWork;
        _logger = logger;
    }

    public async Task Handle(
        Update{{Entity}}Command request,
        CancellationToken cancellationToken)
    {
        var entity = await _repository.GetByIdAsync(request.Id, cancellationToken)
            ?? throw new NotFoundException(nameof({{Entity}}), request.Id);

        // Actualizar usando método del dominio
        entity.Actualizar(
            {{ArgumentosActualizar}}
        );

        await _repository.UpdateAsync(entity, cancellationToken);
        await _unitOfWork.SaveChangesAsync(cancellationToken);

        _logger.LogInformation(
            "{{Entity}} {Id} actualizado/a",
            entity.Id);
    }
}

#endregion

#region Delete{{Entity}}Command

public record Delete{{Entity}}Command(int Id) : IRequest;

public class Delete{{Entity}}CommandHandler : IRequestHandler<Delete{{Entity}}Command>
{
    private readonly I{{Entity}}Repository _repository;
    private readonly IUnitOfWork _unitOfWork;
    private readonly ICurrentUserService _currentUser;
    private readonly ILogger<Delete{{Entity}}CommandHandler> _logger;

    public Delete{{Entity}}CommandHandler(
        I{{Entity}}Repository repository,
        IUnitOfWork unitOfWork,
        ICurrentUserService currentUser,
        ILogger<Delete{{Entity}}CommandHandler> logger)
    {
        _repository = repository;
        _unitOfWork = unitOfWork;
        _currentUser = currentUser;
        _logger = logger;
    }

    public async Task Handle(
        Delete{{Entity}}Command request,
        CancellationToken cancellationToken)
    {
        var entity = await _repository.GetByIdAsync(request.Id, cancellationToken)
            ?? throw new NotFoundException(nameof({{Entity}}), request.Id);

        // Soft delete usando método del dominio
        entity.Delete(_currentUser.UserName ?? "system");

        await _repository.UpdateAsync(entity, cancellationToken);
        await _unitOfWork.SaveChangesAsync(cancellationToken);

        _logger.LogInformation(
            "{{Entity}} {Id} eliminado/a por {User}",
            entity.Id,
            _currentUser.UserName);
    }
}

#endregion

