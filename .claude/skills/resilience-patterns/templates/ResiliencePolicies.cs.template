namespace {{NombreProyecto}}.Infrastructure.Resilience;

using Microsoft.Extensions.Configuration;
using Microsoft.Extensions.DependencyInjection;
using Microsoft.Extensions.Http.Resilience;
using Polly;
using Polly.CircuitBreaker;
using Polly.Retry;
using Polly.Timeout;

/// <summary>
/// Configuracion de politicas de resiliencia para HttpClients en {{NombreProyecto}}.
/// </summary>
public static class ResiliencePolicies
{
    /// <summary>
    /// Anade resiliencia estandar a un HttpClient con Retry + Circuit Breaker + Timeout.
    /// </summary>
    public static IHttpClientBuilder AddResilienciaEstandar(
        this IHttpClientBuilder builder,
        string serviceName = "default")
    {
        builder.AddResilienceHandler($"{serviceName}-pipeline", pipeline =>
        {
            // 1. Timeout total (30 segundos)
            pipeline.AddTimeout(new TimeoutStrategyOptions
            {
                Timeout = TimeSpan.FromSeconds(30),
                Name = $"{serviceName}-timeout"
            });

            // 2. Retry (3 intentos, backoff exponencial con jitter)
            pipeline.AddRetry(new RetryStrategyOptions<HttpResponseMessage>
            {
                MaxRetryAttempts = 3,
                Delay = TimeSpan.FromSeconds(1),
                BackoffType = DelayBackoffType.Exponential,
                UseJitter = true,
                ShouldHandle = new PredicateBuilder<HttpResponseMessage>()
                    .Handle<HttpRequestException>()
                    .Handle<TimeoutRejectedException>()
                    .HandleResult(r => r.StatusCode == System.Net.HttpStatusCode.TooManyRequests
                        || r.StatusCode == System.Net.HttpStatusCode.ServiceUnavailable
                        || r.StatusCode == System.Net.HttpStatusCode.GatewayTimeout),
                Name = $"{serviceName}-retry"
            });

            // 3. Circuit Breaker (5 fallos en 30s -> abierto 30s)
            pipeline.AddCircuitBreaker(new CircuitBreakerStrategyOptions<HttpResponseMessage>
            {
                FailureRatio = 0.5,
                SamplingDuration = TimeSpan.FromSeconds(30),
                MinimumThroughput = 5,
                BreakDuration = TimeSpan.FromSeconds(30),
                ShouldHandle = new PredicateBuilder<HttpResponseMessage>()
                    .Handle<HttpRequestException>()
                    .Handle<TimeoutRejectedException>()
                    .HandleResult(r => (int)r.StatusCode >= 500),
                Name = $"{serviceName}-circuit-breaker"
            });
        });

        return builder;
    }

