# =============================================================================
# {{PROJECT_NAME}} - CI + publicacion NuGet (dotnet tool / libreria)
# Ovillo cicd-architect nettool @ {{TEMPLATE_STAMP}}   (sello de plantilla; /cicd-status detecta drift)
# -----------------------------------------------------------------------------
# Plantilla Ovillo cicd-architect - Variante C (stack .NET-tool / CLI / libreria)
# Cumple R1-R25 de cicd-runtime.md. Validado en MyCompany.Mira.Coverage.
#
# NO es una web: el entregable es un .nupkg publicado al feed interno de la organización.
# Un solo stage (BUILDERS+LADYADA): el agente de build y la share son la misma
# maquina -> publicar es Copy-Item local; ademas evita el bug SSL de descarga de
# artefactos entre stages en TFS 2020 (R3).
#
# Prerrequisito de infra (pedir a Sistemas 1 vez, analogo al permiso Use de
# BUILDERS - TEC-003): la cuenta de servicio del agente en LADYADA necesita
# ESCRITURA NTFS sobre la share del feed (sustituye la capability DeployTarget).
#
# Gate de seguridad R22: opcional para paquetes. El scan de deps/SAST puede
# correr como informe en el Build, pero NO hay stage de deploy que bloquear.
# =============================================================================

name: $(date:yyyyMMdd)$(rev:.r)

trigger:
  branches:
    include:
      - {{RAMA_BASE}}              # CI en cada push (R21: derivar de branching.estrategia)
  tags:
    include:
      - 'v*'                       # tag v* dispara la publicacion del .nupkg al feed
  paths:
    include:
      - '03_Desarrollo/**'         # top-level (R7)
      - '03_Desarrollo/**/*'       # subdirectorios profundos (workaround R7)
      - '04_Pruebas/**'
      - '04_Pruebas/**/*'
      - 'Directory.Build.props'
      - 'Directory.Packages.props'
      - 'global.json'
      - '{{SLN_OR_SLNX}}'
      - 'azure-pipelines.yml'

pr: none                            # R21: PR triggers se gestionan por branch policy (UI), no en YAML

variables:
  buildConfiguration: 'Release'
  solution: '{{SLN_OR_SLNX}}'
  packProject: '{{PACK_CSPROJ_PATH}}'
  nupkgOutputDir: '{{PACKAGE_OUTPUT_DIR}}'
  nugetShare: '\\build01\Repositorio\MyOrg\PaquetesNuget'
  coverageLineThreshold: {{COVERAGE_LINE_THRESHOLD}}
  coverageBranchThreshold: {{COVERAGE_BRANCH_THRESHOLD}}

stages:
  - stage: BuildTestPublish
    displayName: 'Build - Test - (Publish en tags)'
    jobs:
      - job: Pipeline
        displayName: 'CI + publicacion NuGet'
        pool:
          name: BUILDERS                              # R1: automation pool server-wide
          demands:
            - Agent.ComputerName -equals LADYADA      # R1: agente de build = host de la share
        steps:
          - checkout: self

          - task: UseDotNet@2                          # R4: version canonica
            displayName: 'Asegurar .NET SDK'
            inputs:
              packageType: sdk
              version: '{{SDK_VERSION}}'
              includePreviewVersions: true

          - task: DotNetCoreCLI@2                       # R4
            displayName: 'Restore'
            inputs:
              command: restore
              projects: '$(solution)'

          - task: DotNetCoreCLI@2                       # R4
            displayName: 'Build (Release, TreatWarningsAsErrors)'
            inputs:
              command: build
              projects: '$(solution)'
              arguments: '--configuration $(buildConfiguration) --no-restore'

          - powershell: |
              $ErrorActionPreference = 'Stop'
              $covDir = Join-Path $env:AGENT_TEMPDIRECTORY 'coverage'
              $a = "test `"$(solution)`" --configuration $(buildConfiguration) --no-build " +
                   "--collect:`"XPlat Code Coverage`" --results-directory `"$covDir`" " +
                   "--logger `"trx;LogFileName=tests.trx`""
              if (Test-Path '$(Build.SourcesDirectory)/coverlet.runsettings') {
                  $a += " --settings `"$(Build.SourcesDirectory)/coverlet.runsettings`""
              }
              Invoke-Expression "dotnet $a"
              if ($LASTEXITCODE -ne 0) { throw "dotnet test fallo (exit $LASTEXITCODE)" }
            displayName: 'Test + cobertura'

          - task: PublishTestResults@2                  # R4
            displayName: 'Publicar resultados de tests'
            condition: succeededOrFailed()
            inputs:
              testResultsFormat: VSTest
              testResultsFiles: '$(Agent.TempDirectory)/coverage/**/tests.trx'
              failTaskOnFailedTests: true

          - powershell: |
              $ErrorActionPreference = 'Stop'
              $covDir = Join-Path $env:AGENT_TEMPDIRECTORY 'coverage'
              $reportDir = Join-Path '$(Build.ArtifactStagingDirectory)' 'coverage-report'
              $xmls = Get-ChildItem $covDir -Recurse -Filter 'coverage.cobertura.xml' |
                      ForEach-Object { "-i `"$($_.FullName)`"" }
              if (-not $xmls) { throw "No se encontro coverage.cobertura.xml en $covDir" }
              $inputs = $xmls -join ' '

              # Dogfooding: si ESTE proyecto es Mira, correr desde fuente (evita circularidad).
              # Si NO es Mira, instalar/actualizar la tool global desde el feed interno:
              #   if (-not ((dotnet tool list --global) -match 'reportgenerator')) {
              #       dotnet tool install --global MyCompany.Mira.Coverage --add-source '$(nugetShare)'
              #   } else { dotnet tool update --global MyCompany.Mira.Coverage --add-source '$(nugetShare)' }
              #   $env:PATH = "$env:USERPROFILE\.dotnet\tools;$env:PATH"; $mira = "mira"
              $mira = "dotnet run --project `"$(packProject)`" --configuration $(buildConfiguration) --no-build --"

              Invoke-Expression "$mira generate $inputs -o `"$reportDir`""
              Invoke-Expression "$mira badge $inputs -o `"$reportDir/coverage-line.svg`""
              Invoke-Expression "$mira badge $inputs -o `"$reportDir/coverage-branch.svg`" --metric branch"

              Invoke-Expression "$mira summary $inputs"
              if ($LASTEXITCODE -ne 0) { throw "Gate de cobertura incumplido (exit $LASTEXITCODE)" }
            displayName: 'Reporte Mira (dogfooding)'

          - task: PublishCodeCoverageResults@1          # R4: @1 con Cobertura (no @2)
            displayName: 'Publicar cobertura (Cobertura)'
            condition: succeededOrFailed()
            inputs:
              codeCoverageTool: Cobertura
              summaryFileLocation: '$(Agent.TempDirectory)/coverage/**/coverage.cobertura.xml'
              reportDirectory: '$(Build.ArtifactStagingDirectory)/coverage-report'

          - task: PublishBuildArtifacts@1               # R4
            displayName: 'Publicar reporte HTML'
            condition: succeededOrFailed()
            inputs:
              PathtoPublish: '$(Build.ArtifactStagingDirectory)/coverage-report'
              ArtifactName: 'CoverageReport'

          # build#65: usar 'dotnet pack' por PowerShell, NUNCA el task DotNetCoreCLI@2 con
          # command:'pack' -> fuerza --output $(Build.ArtifactStagingDirectory) e IGNORA
          # <PackageOutputPath> del .csproj (Mira_Coverage build #65: el .nupkg no aparecia
          # en nupkgOutputDir y la publicacion fallaba). Ver Tabla A de tfs-2020-limitations.md.
          - powershell: |
              $ErrorActionPreference = 'Stop'
              dotnet pack "$(packProject)" --configuration $(buildConfiguration) --no-build
              if ($LASTEXITCODE -ne 0) { throw "dotnet pack fallo (exit $LASTEXITCODE)" }
            displayName: 'Pack (solo en tags v*)'
            condition: and(succeeded(), startsWith(variables['Build.SourceBranch'], 'refs/tags/v'))

          - powershell: |
              $ErrorActionPreference = 'Stop'
              $pkg = Get-ChildItem '$(nupkgOutputDir)' -Filter '*.nupkg' -ErrorAction Stop |
                     Sort-Object LastWriteTime -Descending | Select-Object -First 1
              if (-not $pkg) { throw "No se encontro ningun .nupkg en $(nupkgOutputDir)" }
              $dest = '$(nugetShare)'
              if (-not (Test-Path $dest)) { throw "Share no accesible: $dest (permisos NTFS del agente - pedir a Sistemas)" }
              $target = Join-Path $dest $pkg.Name
              if (Test-Path $target) {
                  throw "Ya existe '$($pkg.Name)' en la share. Las versiones NuGet son inmutables: " +
                        "sube <Version> en el .csproj y vuelve a taggear."
              }
              Copy-Item -Path $pkg.FullName -Destination $target -Force
              Write-Host "##[section]Publicado $($pkg.Name) en $dest"
            displayName: 'Publicar .nupkg en la share (solo en tags v*)'
            condition: and(succeeded(), startsWith(variables['Build.SourceBranch'], 'refs/tags/v'))
