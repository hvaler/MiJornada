console.log("🔑 API Key added as header: " + apiKeyHeader);
`;

// ============================================================================
// PRE-REQUEST: HttpSignature
// ============================================================================
const PREREQUEST_HTTP_SIGNATURE = `
// HttpSignature Authentication (informational)
// NOTE: Postman does not natively support RSA signing.
// For HttpSignature auth, use Newman with a custom pre-request script
// or an external signing service.
const privateKey = pm.environment.get("httpSignaturePrivateKey");
const algorithm = pm.environment.get("httpSignatureAlgorithm") || "RSA-SHA256";

if (!privateKey) {
    console.warn("⚠️ httpSignaturePrivateKey not configured.");
    console.warn("   HttpSignature requires external signing. See http-signature-mtls.md");
    return;
}

console.log("ℹ️ HttpSignature configured with algorithm: " + algorithm);
console.log("   Use Newman + crypto script for actual request signing.");
`;

